          "content": [
            {
              "type": "text",
              "content": "RAG知识库核心文件维度总览",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "content": [
            {
              "type": "text",
              "content": "可以将所有文件和数据源划分为以下 "
