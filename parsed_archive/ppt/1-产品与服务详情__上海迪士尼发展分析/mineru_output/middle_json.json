            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "content": [
            {
              "type": "text",
              "content": "一份爆米花30元，如果带个桶，居然要多加65元！",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 22,
      "blocks": [
        {
          "type": "image",
          "index": 0,
          "content": [
            {
              "type": "image_body",
              "index": 0,
              "image_path": "images/page_22_image_0.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "image",
          "index": 1,
          "content": [
            {
              "type": "image_body",
              "index": 1,
              "image_path": "images/page_22_image_1.jpg",
