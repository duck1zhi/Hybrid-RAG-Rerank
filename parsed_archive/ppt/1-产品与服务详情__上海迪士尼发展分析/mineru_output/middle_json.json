              "image_path": "images/page_23_image_0.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "image",
          "index": 1,
          "content": [
            {
              "type": "image_body",
              "index": 1,
              "image_path": "images/page_23_image_1.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "content": [
            {
              "type": "image_body",
              "index": 2,
              "image_path": "images/page_23_image_2.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "content": [
            {
              "type": "text",
              "content": "迪士尼版 买家秀VS买家秀",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 24,
      "blocks": [
        {
          "type": "image",
          "index": 0,
          "content": [
            {
              "type": "image_body",
              "index": 0,
              "image_path": "images/page_24_image_0.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "content": [
            {
              "type": "text",
              "content": "目前上海有上海迪士尼乐园酒店、玩具总动员酒店，日常价格在每晚1000-3600元不等，经常订不到。",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 25,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "content": [
            {
              "type": "text",
              "content": "一家三口从北京 到上海迪士尼基础花费"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 1,
          "content": [
            {
              "type": "image_body",
              "index": 1,
              "image_path": "images/page_25_image_1.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "list",
          "index": 2,
          "content": [
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "- "
                },
                {
                  "type": "text",
                  "content": "总计（两天一晚）：高铁往返（553*3）*2+门票（670*2+510）+酒店（1950）+食物（300*6）+纪念品1000=9918（元）",
                  "styles": [
                    "bold"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "list",
          "index": 3,
          "content": [
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "- 高铁553-933元、飞机票570-1240元"
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "- 1日票：标准票370元每位、儿童票280一位"
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "- 2日票：标准票670元每位、儿童票510一位"
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "- 酒店一晚1950+"
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "- 基础一顿饭+饮料300+"
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "- 纪念品1000元"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "content": [
            {
              "type": "text",
              "content": "这个价格你能接受吗？",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 26,
      "blocks": [
        {
          "type": "text",
          "index": 0,
          "content": [
            {
              "type": "text",
              "content": "三、园区现状"
            }
          ]
        },
        {
          "type": "image",
          "index": 1,
          "content": [
            {
              "type": "image_body",
              "index": 1,
              "image_path": "images/page_26_image_1.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "content": [
            {
              "type": "text",
              "content": "从全球范围来看，像上海迪士尼这么大规模的乐园，在营运前期都会面临一些问题。",
              "styles": [
                "bold"
              ]
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "content": [
            {
              "type": "text",
              "content": "据近日《劳动报》报道，迪士尼乐园附近黄牛倒票猖獗，原价499元的旺季迪士尼成人票竟然标出了200元至470元不等的折扣价。而此前，迪士尼亦被爆出网购票在检票时被告知无效。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "content": [
            {
              "type": "text",
              "content": "上海迪士尼乐园被爆出设备故障、黄牛倒票、网购票无效、排队时间过长、园区管理运营不到位等问题，使得新开园的“米老鼠经济”再次陷入了舆论的漩涡，也让业界对于迪士尼的前景喜忧参半。",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 27,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "content": [
            {
              "type": "text",
              "content": "四、主要问题"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "content": [
            {
              "type": "text",
              "content": "1、提到上海人们的旅游感知是外滩，东方明珠等，迪士尼不是主要的经典参观景点。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "content": [
            {
              "type": "text",
              "content": "2、中国人旅游经济的习惯向来是讲究性价比高。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "content": [
            {
              "type": "text",
              "content": "3、上海迪士尼价格水平不适合中国人的节俭习惯与消费态度。",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 28,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "content": [
            {
              "type": "text",
              "content": "五、具体分析"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 1,
          "content": [
            {
              "type": "image_body",
              "index": 1,
              "image_path": "images/page_28_image_1.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "content": [
            {
              "type": "text",
              "content": "百余年来，上海一直是中国商业的中心、财富的汇聚地，是一个新兴的旅游目的地，是一座极具现代化而又不失中国传统特色的国际大都市。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "content": [
            {
              "type": "text",
              "content": "由于它深厚的文化底蕴与众多的历史古迹，又是中国的商业中心，城市的旅游感知形象与主题公园不与谐。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "content": [
            {
              "type": "text",
              "content": "游客大多数选择独一无二的景观，如外滩，东方明珠等，迪士尼并不是主要经典的参观景点。",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 29,
      "blocks": [
        {
          "type": "image",
          "index": 0,
          "content": [
            {
              "type": "image_body",
              "index": 0,
              "image_path": "images/page_29_image_0.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "content": [
            {
              "type": "text",
              "content": "上海拥有极具特色的上海文化，人文景观，标志性建筑物对主题公园的需求相对较少。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "content": [
            {
              "type": "text",
              "content": "大众对于迪士尼的新鲜感逐渐退烧，毕竟其并非高频消费，在开业之初的这波热情退却之后，迪士尼很难留住游客。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "content": [
            {
              "type": "text",
              "content": "中国人旅游经济的习惯向来是讲究性价比高，上海迪士尼价格水平不适合中国人的节俭习惯与消费态度。",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 30,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "content": [
            {
              "type": "text",
              "content": "六、改进建议"
            }
          ],
          "level": 2
        },
        {
          "type": "image",
          "index": 1,
          "content": [
            {
              "type": "image_body",
              "index": 1,
              "image_path": "images/page_30_image_1.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "content": [
            {
              "type": "text",
              "content": "1、尽量减少前期投资成本。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "content": [
            {
              "type": "text",
              "content": "对于上海的迪士尼建设而言，在巨大的投入成本与回收周期之间，大多可能也会与香港的迪士尼一样，有一个比较漫长的回收过程。因此，上海迪士尼在前期建设上应该以滚动的形式推进乐园建设，这样可以在某种程度上减轻成本投入的压力。中方在投入时应该审慎考量，避免政府与国家在参与建设过程中耗费巨大，成本回收的缓慢极易让中方陷入鸡肋效应，从而难以获益甚至亏损。",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 31,
      "blocks": [
        {
          "type": "image",
          "index": 0,
          "content": [
            {
              "type": "image_body",
              "index": 0,
              "image_path": "images/page_31_image_0.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 1,
          "content": [
            {
              "type": "text",
              "content": "2、赢客源者赢天下。",
              "styles": [
                "bold"
              ]
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 2,
          "content": [
            {
              "type": "text",
              "content": "迪士尼要关注游客新鲜感下降，消费者热情退烧等问题。虽然迪士尼乐园开园至今已有六十余年历史，形成了一套较为成熟的体系，但这并不能说明目前上海迪士尼乐园的运营模式无懈可击。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "content": [
            {
              "type": "text",
              "content": "其次，上海一定要注意多渠道开拓客源市场，不能只依靠长三角市场，而要依靠全国市场，更需要开拓东南亚市场。要注意在乐园中融入中国特色、上海特点，使之具有鲜明的个性风格，并时刻注意迎合市场的需求。",
              "styles": [
                "bold"
              ]
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "content": [
            {
              "type": "text",
              "content": "上海迪士尼在本土化战略过程中，需结合本地实际情况更新或调整运营策略。",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    },
    {
      "page_idx": 32,
      "blocks": [
        {
          "type": "image",
          "index": 0,
          "content": [
            {
              "type": "image_body",
              "index": 0,
              "image_path": "images/page_32_image_0.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "content": [
            {
              "type": "text",
              "content": "谢谢观赏",
              "styles": [
                "bold"
              ]
            }
          ]
        }
      ]
    }
