                0.157,
                0.526,
                0.847,
                0.72
              ],
              "image_path": "images/page_0_chart_6.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.147,
            0.761,
            0.255,
            0.783
          ],
          "content": [
            {
              "type": "text",
              "content": "功能差异"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.146,
            0.815,
            0.852,
            0.852
          ],
          "content": [
            {
              "type": "text",
              "content": "- 画质:Disney+支持高达4K超高清和HDR的画质，为用户提供生动的色彩和详细的图像体验[3]。不过，并非所有内容都支持4K，具体取决于设备和内容的可用性[11]。"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.147,
            0.876,
            0.846,
            0.894
          ],
          "content": [
            {
              "type": "text",
              "content": "- 同时观看设备数量:Disney+基本计划允许在最多4台设备上同时观看内容，而Premium"
            }
          ]
        },
        {
